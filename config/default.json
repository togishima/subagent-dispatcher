{
  "$comment": "Default jev-dispatch configuration. Copy to ~/.jev-dispatch/config.json (or .yaml) and edit. Every value here is overridable; user config is deep-merged over this.",

  "routing": {
    "mode": "policy-graph",
    "fixedTier": "high",
    "fallbackTierOnRouterError": "medium",

    "policyGraph": {
      "path": "policies/v2.json",
      "defaultMinConfidence": 0.6,
      "overRouteOnUncertain": true,
      "onEvaluatorUnavailable": "safer-branch",
      "maxTraversalSteps": 32
    },

    "jevDirect": {
      "confidencePolicy": {
        "enabled": true,
        "minMaxProbability": 0.6,
        "floorTier": "medium"
      }
    },

    "semanticEvaluator": {
      "$comment": "Who answers the policy graph's boolean predicates. The graph itself is unaffected by this choice. jev calls TypeSafe or a gateway; laya runs locally on Apple silicon; mock returns fixed answers. Leaving this out keeps the original behaviour, which is jev.",
      "provider": "jev",
      "mock": {
        "answers": {},
        "defaultProbability": 0.5
      }
    },

    "jev": {
      "$comment": "provider picks the defaults below; every one of them can be overridden. Only the typesafe shape has been checked against a running service — run `jev-dispatch check-router` before trusting another.",
      "provider": "typesafe",
      "endpoint": null,
      "apiKeyEnv": null,
      "accountId": null,
      "headers": {},
      "model": "jev-latest",
      "timeoutMs": 8000,
      "maxRetries": 3,
      "sendPlan": true,
      "maxPlanChars": 4000
    }
  },

  "tiers": {
    "low":    { "order": 1, "worker": "haiku",  "description": "Mechanical and local: the work is obvious, single-step, or pure lookup/formatting. Any fast small model does it just as well." },
    "medium": { "order": 2, "worker": "sonnet", "description": "Ordinary engineering: a few dependent steps using familiar patterns, little ambiguity, a competent mid-tier model is enough." },
    "high":   { "order": 3, "worker": "opus",   "description": "Hard or high-stakes: cross-cutting design, subtle debugging, interacting constraints, or correctness matters more than cost." }
  },

  "workers": {
    "haiku":  { "kind": "claude-agent", "model": "haiku",  "agent": "low-worker",    "maxTurns": 20, "frontier": false },
    "sonnet": { "kind": "claude-agent", "model": "sonnet", "agent": "medium-worker", "maxTurns": 30, "frontier": false },
    "opus":   { "kind": "claude-agent", "model": "opus",   "agent": "high-worker",   "maxTurns": 40, "frontier": true }
  },

  "workerDefaults": {
    "permissionMode": "acceptEdits",
    "allowVerificationCommands": true,
    "bare": false,
    "strictMcpConfig": true,
    "timeoutMs": 900000,
    "allowedTools": [],
    "disallowedTools": [
      "Task", "Agent",
      "mcp__jev-dispatch__delegate",
      "mcp__plugin_jev-dispatch_jev-dispatch__delegate"
    ],
    "extraArgs": [],
    "passEnv": [
      "PATH", "HOME", "LANG", "LC_ALL", "TERM", "SHELL", "USER", "LOGNAME", "TMPDIR",
      "ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY",
      "ANTHROPIC_CUSTOM_HEADERS", "ANTHROPIC_MODEL", "AWS_REGION",
      "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
      "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy",
      "NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE", "REQUESTS_CA_BUNDLE",
      "GIT_CONFIG_GLOBAL", "XDG_CACHE_HOME", "XDG_CONFIG_HOME"
    ]
  },

  "escalation": {
    "enabled": true,
    "maxAttemptsPerTask": 3,
    "escalateOn": ["CAPABILITY_FAILURE"],
    "retrySameTierOn": ["ENVIRONMENT_FAILURE"],
    "maxSameTierRetries": 1,
    "uncertainCountsAsPass": true
  },

  "verification": {
    "enabled": true,
    "timeoutMs": 300000,
    "allowInlineCommands": false,
    "checks": []
  },

  "contract": {
    "sessionStartNudge": true,
    "briefCheck": "advise"
  },

  "telemetry": {
    "dbPath": null,
    "retentionDays": 100,
    "storeTitles": true,
    "titleMaxLength": 80,
    "debugStoreRawInput": false
  },

  "ui": {
    "host": "127.0.0.1",
    "port": 4319,
    "autoStart": false
  },

  "otel": {
    "receiverEnabled": true
  }
}
